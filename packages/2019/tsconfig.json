{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es2015",
    "jsx": "react",

    "allowSyntheticDefaultImports": true,
    "rootDir": ".",
    "paths": {
      "src/*": [ "./src/*", "./src/*.js" ]
    },
    "moduleResolution": "bundler",
    "lib": ["es6", "dom"],
    "resolveJsonModule": true,
  },
  "include": [
    "./src/**/*"
  ]
}
